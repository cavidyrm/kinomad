# .env for deploy/docker-compose.yml — copy to .env and fill in.
# Never commit the filled copy.

# Postgres
PGUSER=kinomad
PGPASSWORD=
PGDATABASE=kinomad

# Session signing key — generate once, keep stable, rotating it logs everyone out:
#   openssl rand -hex 32
SESSION_SECRET=

# Who may sign in at /admin/login. Comma-separated, no spaces.
ADMIN_EMAILS=hello@kinomadstudio.com

# Public origin, used for absolute links in confirmation emails and canonical URLs.
PUBLIC_ORIGIN=https://kinomadstudio.com

# Override if you publish the backend images elsewhere.
API_IMAGE=ghcr.io/cavidyrm/kinomad-api:latest
DEMO_IMAGE=ghcr.io/cavidyrm/kinomad-demo:latest
